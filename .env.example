# X API
# Add the real value only to GitHub Actions Secrets or a local untracked .env.
X_BEARER_TOKEN=

# Runtime
TRENDSBOT_MODE=test
SCAN_INTERVAL_MINUTES=240
MAX_SIGNAL_AGE_MINUTES=5
MAX_LAUNCHES_PER_CYCLE=2
TOKEN_LAUNCH_ENABLED=false

# Intelligence
# deterministic keeps tests/network-free. Set to llm only when the LLM secret is configured.
INTELLIGENCE_PROVIDER=deterministic
INTELLIGENCE_API_KEY=
INTELLIGENCE_API_URL=https://api.groq.com/openai/v1/chat/completions
INTELLIGENCE_MODEL=openai/gpt-oss-20b
